<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><title>اهناسيتنا وطنيتنا | رحلة الملك</title>
<style>
:root{--gold:#ffda76;--navy:#07172d}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#07172d;color:#fff;font-family:Tahoma,Arial,sans-serif;touch-action:none}#game{position:fixed;inset:0;overflow:hidden;background:radial-gradient(ellipse at 50% 18%,#416a80 0,#1b3c55 35%,#07172d 75%)}.stars{position:absolute;inset:0;opacity:.4;background-image:radial-gradient(#fff 1px,transparent 1.5px),radial-gradient(#ffd978 1px,transparent 1.5px);background-size:73px 81px,113px 109px;background-position:10px 15px,39px 55px}.sun{position:absolute;top:10%;left:50%;width:105px;height:105px;transform:translateX(-50%);border-radius:50%;background:radial-gradient(circle,#fff4bd,#ffd36b 40%,#ffbe4822 72%,transparent 74%);filter:drop-shadow(0 0 28px #ffc65c)}.dune{position:absolute;bottom:22%;left:-10%;width:120%;height:26%;border-radius:50% 50% 0 0;background:linear-gradient(#b9783b,#573927)}.temple{position:absolute;left:50%;top:20%;width:min(54vw,350px);height:32%;transform:translateX(-50%);opacity:.78;filter:drop-shadow(0 0 15px #ffc56a33)}.roof{position:absolute;top:0;left:3%;width:94%;height:14%;background:linear-gradient(#f7d9a0,#997049);clip-path:polygon(5% 0,95% 0,100% 100%,0 100%)}.lintel{position:absolute;top:14%;width:100%;height:8%;background:linear-gradient(90deg,#7e552e,#e4bb77,#81542e)}.col{position:absolute;top:22%;height:72%;width:14%;background:repeating-linear-gradient(90deg,#77502f 0 5px,#d2a56c 6px 13px,#f0ce91 14px 17px);border-top:7px solid #f0ce91;border-bottom:7px solid #78502f}.c1{left:4%}.c2{left:28%}.c3{left:52%}.c4{left:76%}.base{position:absolute;bottom:0;left:-4%;width:108%;height:8%;background:#b88a54}#road{position:absolute;left:50%;bottom:-8%;width:min(95vw,690px);height:83%;transform:translateX(-50%);clip-path:polygon(43% 0,57% 0,100% 100%,0 100%);background:repeating-linear-gradient(0deg,transparent 0 37px,#fff1 38px 40px),linear-gradient(90deg,#573b2e,#c79a5c 18%,#8d633e 50%,#d2a56b 82%,#53392b);filter:drop-shadow(0 -4px 15px #ffc45e22)}.lane{position:absolute;bottom:-2%;height:76%;width:3px;left:50%;background:repeating-linear-gradient(to bottom,#ffe1a6b3 0 24px,transparent 24px 58px);opacity:.65}#objects{position:absolute;inset:0;pointer-events:none}.obj{position:absolute;transform:translate(-50%,-50%);will-change:top,left,scale}.coin{width:28px;height:28px;border-radius:50%;border:3px solid #fff0a5;background:radial-gradient(circle at 30% 25%,#fff8b8,#ffcb31 42%,#b66a05 76%,#fff0a1 83%);box-shadow:0 0 12px #ffc42e,0 0 25px #ffbd2455;display:grid;place-items:center;color:#9b4d00;font-size:13px;font-weight:bold}.coin:after{content:'𓂀'}.block{width:47px;height:49px;border:2px solid #ffdda0;border-radius:5px;background:linear-gradient(90deg,#593a28,#d1a16b 25%,#f2d39b 48%,#94603a 80%);box-shadow:0 8px 0 #573822}.block:before{content:'';position:absolute;top:-12px;left:-4px;width:calc(100% + 8px);height:13px;background:linear-gradient(#f7d99e,#a56b3b)}.gate{height:65px;width:58px;border-radius:7px 7px 0 0;background:linear-gradient(90deg,#543824,#a87541,#e4bb7d,#754728)}.gate:after{content:'';position:absolute;left:10px;right:10px;top:12px;bottom:0;border:3px solid #4b3020;border-bottom:0;background:#07172d44}#heroWrap{position:absolute;bottom:13%;left:50%;width:100px;height:160px;transform:translateX(-50%);z-index:5;filter:drop-shadow(0 13px 8px #20170d99);transition:left .13s}#hero{position:absolute;inset:0;animation:run .42s ease-in-out infinite alternate}@keyframes run{to{translate:0 -5px;rotate:1deg}}.shadow{position:absolute;bottom:0;left:17%;width:66%;height:18px;border-radius:50%;background:#21170d99;filter:blur(4px)}.body{position:absolute;bottom:10px;left:24px;width:52px;height:72px;background:linear-gradient(90deg,#a8732b,#fff0bd 25%,#e9c875 60%,#9c6226);clip-path:polygon(15% 0,85% 0,100% 100%,0 100%);border:2px solid #ffe29a}.belt{position:absolute;bottom:48px;left:23px;width:54px;height:10px;background:linear-gradient(#fff0a2,#b87520);border:1px solid #ffdf81}.head{position:absolute;top:28px;left:32px;width:36px;height:42px;border-radius:45%;background:linear-gradient(90deg,#8e4c27,#d99a5b 42%,#f2bc79 70%,#8e4c27)}.eye{position:absolute;top:45px;width:6px;height:5px;background:#171522;border-radius:50%}.eye.l{left:39px}.eye.r{right:39px}.beard{position:absolute;top:61px;left:43px;width:14px;height:19px;background:linear-gradient(90deg,#161d2c,#b58a3c,#111a2a);clip-path:polygon(15% 0,85% 0,70% 100%,30% 100%)}.crown{position:absolute;top:3px;left:20px;width:60px;height:46px;border-radius:25px 25px 6px 6px;background:repeating-linear-gradient(90deg,#0c1b32 0 8px,#e0ae47 8px 12px);border:3px solid #ffdc7b;clip-path:polygon(12% 0,88% 0,100% 100%,0 100%);box-shadow:0 0 15px #ffd35b88}.crown:after{content:'';position:absolute;top:1px;left:24px;width:10px;height:19px;background:linear-gradient(#fff0a4,#d99416);border-radius:50% 50% 3px 3px}.arm{position:absolute;top:82px;width:14px;height:46px;background:linear-gradient(90deg,#995b2b,#f2bd78);border-radius:10px;transform-origin:top}.arm.a{left:14px;animation:arms .42s infinite alternate}.arm.b{right:14px;animation:arms .42s infinite alternate-reverse}@keyframes arms{to{rotate:50deg}}.leg{position:absolute;bottom:0;width:18px;height:35px;border-radius:5px;background:linear-gradient(90deg,#263047,#080f20);transform-origin:top}.leg.a{left:28px;animation:legs .42s infinite alternate}.leg.b{right:28px;animation:legs .42s infinite alternate-reverse}@keyframes legs{to{rotate:28deg;translate:0 3px}}#hero.jumping{animation:jump .62s ease-out}@keyframes jump{0%{translate:0 0}40%{translate:0 -90px}100%{translate:0 0}}#hero.sliding{transform:scaleY(.55) translateY(45px)}.hud{position:absolute;z-index:20;top:0;left:0;right:0;padding:calc(env(safe-area-inset-top) + 12px) 14px 0;display:flex;justify-content:space-between;align-items:flex-start;gap:8px;pointer-events:none}.brand{font-size:clamp(13px,3.5vw,19px);font-weight:900;color:#ffe7a0;text-shadow:0 2px #6b3e13,0 0 18px #ffcc56}.subbrand{font-size:9px;color:#d5e5f4;margin-top:4px;letter-spacing:2px}.stats{display:flex;gap:7px}.stat{min-width:66px;padding:8px;border:1px solid #ffe2a266;border-radius:13px;background:#07172ddd;text-align:center;backdrop-filter:blur(7px)}.stat small{display:block;color:#a9c4d8;font-size:10px;margin-bottom:3px}.stat b{font-size:16px;color:#ffe19a}#soundBtn{pointer-events:auto;border:1px solid #ffe2a266;color:#ffe8b2;background:#07172dcc;border-radius:12px;width:38px;height:38px;font-size:17px}#progress{position:absolute;z-index:10;top:95px;left:50%;transform:translateX(-50%);width:42%;height:4px;background:#ffffff28;border-radius:9px;overflow:hidden}#progressFill{height:100%;width:0;background:linear-gradient(90deg,#ffeaa0,#ff9e20)}#toast{position:absolute;z-index:30;top:18%;left:50%;transform:translate(-50%,-10px);padding:10px 18px;border-radius:999px;background:#07172de8;border:1px solid #ffda83;color:#ffe8ae;font-weight:bold;opacity:0;transition:.25s;white-space:nowrap}#toast.show{opacity:1;transform:translate(-50%,0)}.overlay{position:absolute;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;padding:22px;background:linear-gradient(180deg,#06152ac4,#06152a80 40%,#06152ad9);backdrop-filter:blur(5px)}.panel{width:min(100%,410px);border:1px solid #ffdf8a88;border-radius:26px;padding:25px 22px 22px;text-align:center;background:linear-gradient(150deg,#17314df2,#08172df7 68%);box-shadow:0 25px 80px #0008,inset 0 1px #fff2;position:relative;overflow:hidden}.panel:before{content:'';position:absolute;inset:-50%;background:linear-gradient(110deg,transparent 40%,#fff1 48%,transparent 56%);transform:translateX(-80%);animation:shine 5s infinite}@keyframes shine{50%,100%{transform:translateX(80%)}}.emblem{font-size:52px;filter:drop-shadow(0 0 16px #ffc83f);margin-bottom:4px}h1{font-size:clamp(24px,6vw,33px);margin:0;color:#ffe5a0;text-shadow:0 2px #6e4319}.kicker{font-size:11px;letter-spacing:2px;color:#8edff0;margin:8px 0 18px}.desc{font-size:14px;line-height:1.9;color:#d6e5f2;margin:0 0 18px}.btn{position:relative;z-index:2;width:100%;padding:14px 16px;border:0;border-radius:15px;background:linear-gradient(110deg,#ffe8a0,#ffb72f 58%,#e78a13);color:#39230b;font-weight:900;font-size:17px;box-shadow:0 7px 0 #8c4f14,0 10px 25px #ffb32635;cursor:pointer}.btn:active{transform:translateY(3px);box-shadow:0 4px 0 #8c4f14}.secondary{margin-top:13px;font-size:12px;color:#9ebbd0}#controls{position:absolute;z-index:22;bottom:calc(env(safe-area-inset-bottom) + 17px);left:0;right:0;display:flex;justify-content:space-between;align-items:center;padding:0 18px;pointer-events:none}.pad{display:flex;gap:9px;pointer-events:auto}.ctrl{width:54px;height:54px;border-radius:18px;border:1px solid #ffe5a577;background:linear-gradient(145deg,#183650e8,#07172df0);color:#ffe8aa;font-size:23px;font-weight:bold;box-shadow:0 5px 18px #0005;touch-action:none}.ctrl.action{width:59px;height:59px;border-radius:50%;background:linear-gradient(145deg,#ffe7a0,#e89a21);color:#39240d;border:2px solid #fff0b1}.ctrl:active{transform:scale(.93)}.tip{position:absolute;z-index:15;bottom:calc(env(safe-area-inset-bottom) + 93px);left:50%;transform:translateX(-50%);white-space:nowrap;font-size:11px;color:#fff0c3;text-shadow:0 2px 4px #000;opacity:.85}#flash{position:absolute;inset:0;z-index:18;pointer-events:none;background:#ffcf65;opacity:0}#flash.hit{animation:flash .28s}@keyframes flash{to{opacity:0}}.hidden{display:none!important}@media(min-width:700px){#heroWrap{bottom:10%;transform:translateX(-50%) scale(1.15)}.tip{bottom:30px}#controls{bottom:30px}.ctrl{width:62px;height:62px}}
</style></head><body><div id="game"><div class="stars"></div><div class="sun"></div><div class="temple"><div class="roof"></div><div class="lintel"></div><div class="col c1"></div><div class="col c2"></div><div class="col c3"></div><div class="col c4"></div><div class="base"></div></div><div class="dune"></div><div id="road"></div><div class="lane" style="left:39%"></div><div class="lane" style="left:61%"></div><div id="objects"></div><div id="heroWrap"><div id="hero"><div class="shadow"></div><div class="body"></div><div class="belt"></div><div class="head"></div><div class="eye l"></div><div class="eye r"></div><div class="beard"></div><div class="crown"></div><div class="arm a"></div><div class="arm b"></div><div class="leg a"></div><div class="leg b"></div></div></div><div class="hud"><div><div class="brand">اهناسيتنا وطنيتنا</div><div class="subbrand">رحلة الملك · THE ROYAL RUN</div></div><div class="stats"><div class="stat"><small>العملات</small><b id="coins">0</b></div><div class="stat"><small>النقاط</small><b id="score">0</b></div></div><button id="soundBtn">♫</button></div><div id="progress"><div id="progressFill"></div></div><div id="toast"></div><div id="flash"></div><div class="tip">اسحب يمين أو شمال · اقفز فوق الحواجز</div><div id="controls"><div class="pad"><button class="ctrl" id="leftBtn">‹</button><button class="ctrl" id="rightBtn">›</button></div><div class="pad"><button class="ctrl action" id="slideBtn">↓</button><button class="ctrl action" id="jumpBtn">↑</button></div></div><div class="overlay" id="startScreen"><div class="panel"><div class="emblem">𓂀</div><h1>رحلة الملك</h1><div class="kicker">لعبة اهناسيتنا وطنيتنا</div><p class="desc">انطلق في طريق الملوك، اجمع الذهب، تفادى الحواجز، واكتشف أسرار أهناسيا القديمة.<br>كل عملة تقرّبك من لقب <b style="color:#ffe4a0">ملك أهناسيا</b>.</p><button class="btn" id="startBtn">ابدأ المغامرة</button><div class="secondary">نسخة تجريبية · تحكم باللمس أو لوحة المفاتيح</div></div></div><div class="overlay hidden" id="endScreen"><div class="panel"><div class="emblem" id="endIcon">𓏏</div><h1 id="endTitle">انتهت الرحلة</h1><div class="kicker">نتيجة المغامرة</div><p class="desc" id="endDesc"></p><button class="btn" id="againBtn">العب من جديد</button><div class="secondary" id="bestText"></div></div></div></div>
<script>(()=>{const $=id=>document.getElementById(id),objects=$('objects'),heroWrap=$('heroWrap'),hero=$('hero');let running=false,lane=1,coins=0,score=0,distance=0,speed=.36,spawnTimer=0,objectsList=[],lastTime=0,soundOn=true,audioCtx=null,jumpUntil=0,slideUntil=0,swipeStart=null,best=Number(localStorage.getItem('ehnasitna_best')||0);const laneX=[27,50,73];function audio(freq=700,duration=.08,type='sine',volume=.035){if(!soundOn)return;try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();let o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type=type;o.frequency.value=freq;g.gain.value=volume;o.connect(g);g.connect(audioCtx.destination);o.start();g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+duration);o.stop(audioCtx.currentTime+duration)}catch(e){}}function toast(t){$('toast').textContent=t;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),850)}function updateHud(){$('coins').textContent=coins;$('score').textContent=score;$('progressFill').style.width=Math.min(100,distance/9)+'%'}function setLane(n){if(!running)return;lane=Math.max(0,Math.min(2,n));heroWrap.style.left=laneX[lane]+'%';audio(400,.035,'sine',.015)}function jump(){if(!running||Date.now()<jumpUntil)return;jumpUntil=Date.now()+620;hero.classList.remove('jumping');void hero.offsetWidth;hero.classList.add('jumping');audio(520,.11,'triangle',.035);setTimeout(()=>hero.classList.remove('jumping'),650)}function slide(){if(!running)return;slideUntil=Date.now()+600;hero.classList.add('sliding');audio(260,.09,'triangle',.025);setTimeout(()=>hero.classList.remove('sliding'),620)}function createObject(type,ln){let el=document.createElement('div');el.className='obj '+(type==='coin'?'coin':'obstacle '+(type==='gate'?'gate':''));objects.appendChild(el);let ob={el,type,lane:ln,y:-8,passed:false};objectsList.push(ob);return ob}function spawn(){let r=Math.random(),ln=Math.floor(Math.random()*3);if(r<.62){let count=3+Math.floor(Math.random()*3);for(let i=0;i<count;i++){let ob=createObject('coin',ln);ob.y=-8-i*7}}else{createObject(Math.random()<.45?'gate':'block',ln);if(Math.random()<.45){let other=(ln+1+Math.floor(Math.random()*2))%3,ob=createObject('coin',other);ob.y=-14}}}function hit(ob){if(ob.type==='coin'){coins++;score+=10;audio(880,.07,'sine',.04);if(coins%10===0)toast('عاش يا بطل! +10 عملات');ob.el.remove();return true}let now=Date.now(),isJump=now<jumpUntil,isSlide=now<slideUntil;if((ob.type==='gate'&&isSlide)||(ob.type==='block'&&isJump)){score+=25;audio(620,.08,'triangle',.035);ob.el.remove();toast('مراوغة ممتازة! +25');return true}return false}function endGame(){running=false;best=Math.max(best,score);localStorage.setItem('ehnasitna_best',best);$('endTitle').textContent=score>=500?'ملك أهناسيا!':'انتهت الرحلة';$('endIcon').textContent=score>=500?'♛':'𓏏';$('endDesc').innerHTML='جمعت <b style="color:#ffe3a0">'+coins+'</b> عملة ذهبية، وحققت <b style="color:#ffe3a0">'+score+'</b> نقطة.<br>واصل اللعب وحاول تكسر رقمك القياسي.';$('bestText').textContent='أفضل نتيجة: '+best+' نقطة';$('endScreen').classList.remove('hidden');audio(180,.3,'sawtooth',.04)}function reset(){objectsList.forEach(o=>o.el.remove());objectsList=[];coins=0;score=0;distance=0;speed=.36;spawnTimer=0;lane=1;hero.style.animationPlayState='running';heroWrap.style.left='50%';hero.classList.remove('jumping','sliding');updateHud()}function start(){reset();$('startScreen').classList.add('hidden');$('endScreen').classList.add('hidden');running=true;lastTime=performance.now();requestAnimationFrame(loop);audio(660,.12,'triangle',.04);toast('يلا يا بطل!')}function loop(t){if(!running)return;let dt=Math.min(32,t-lastTime||16);lastTime=t;distance+=dt*.012;score+=Math.floor(dt*.015);speed=Math.min(.72,.36+distance*.00055);spawnTimer+=dt;if(spawnTimer>Math.max(430,880-distance*1.4)){spawn();spawnTimer=0}objectsList=objectsList.filter(ob=>{ob.y+=speed*(dt/16);let depth=ob.y/100,x=laneX[ob.lane]+(ob.lane-1)*depth*1.8;ob.el.style.left=x+'%';ob.el.style.top=ob.y+'%';ob.el.style.scale=.35+depth*1.7;if(ob.y>79&&ob.y<91&&!ob.passed&&ob.lane===lane){ob.passed=true;if(hit(ob))return false;if(ob.type!=='coin'){$('flash').classList.remove('hit');void $('flash').offsetWidth;$('flash').classList.add('hit');endGame();return false}}if(ob.y>110){ob.el.remove();return false}return true});$('road').style.backgroundPositionY=(t*.32)+'px';updateHud();requestAnimationFrame(loop)}$('startBtn').addEventListener('click',start);$('againBtn').addEventListener('click',start);$('leftBtn').addEventListener('pointerdown',e=>{e.preventDefault();setLane(lane-1)});$('rightBtn').addEventListener('pointerdown',e=>{e.preventDefault();setLane(lane+1)});$('jumpBtn').addEventListener('pointerdown',e=>{e.preventDefault();jump()});$('slideBtn').addEventListener('pointerdown',e=>{e.preventDefault();slide()});$('soundBtn').addEventListener('click',()=>{soundOn=!soundOn;$('soundBtn').textContent=soundOn?'♫':'♪';toast(soundOn?'الصوت شغال':'الصوت مكتوم');if(soundOn)audio(660,.08)});document.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown',' ','a','d','w','s'].includes(e.key))e.preventDefault();if(!running){if(e.key==='Enter'||e.key===' ')start();return}if(e.key==='ArrowLeft'||e.key==='a')setLane(lane-1);if(e.key==='ArrowRight'||e.key==='d')setLane(lane+1);if(e.key==='ArrowUp'||e.key==='w'||e.key===' ')jump();if(e.key==='ArrowDown'||e.key==='s')slide()});$('game').addEventListener('pointerdown',e=>{if(e.target.closest('button')||!running)return;swipeStart={x:e.clientX,y:e.clientY}});$('game').addEventListener('pointerup',e=>{if(!swipeStart||!running)return;let dx=e.clientX-swipeStart.x,dy=e.clientY-swipeStart.y;if(Math.max(Math.abs(dx),Math.abs(dy))>28){if(Math.abs(dx)>Math.abs(dy))setLane(lane+(dx>0?-1:1));else if(dy<0)jump();else slide()}swipeStart=null});})();</script></body></html>
